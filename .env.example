# ---------------------------------------------------------------------------
# Website Automation Agent — environment template
# Copy to ".env" (cp .env.example .env). Everything here is OPTIONAL:
# with no .env at all the agent runs in heuristic mode out of the box.
# CLI flags always override these values.
# ---------------------------------------------------------------------------

# Default engine: "heuristic" (no key needed) or "ai"
MODE=heuristic

# Target page to automate
URL=https://ui.shadcn.com/docs/forms/react-hook-form

# Values typed into the two form roles (override with -n / -d)
NAME_VALUE=Automated Test Entry
DESCRIPTION_VALUE=Filled automatically by an autonomous agent using Playwright and TypeScript.

# Browser behaviour
HEADLESS=true          # set "false" to watch the window
TIMEOUT=45000          # navigation / element timeout (ms)
SLOWMO=0               # delay between Playwright ops (ms); raise for demos
OUT_DIR=output         # screenshots + run-log.json (resolved against CWD)

# ----- AI mode (only used with --mode ai) ----------------------------------
# Which LLM backend to use: "groq" (default, free, OpenAI-compatible) or "gemini"
LLM_PROVIDER=groq
MAX_STEPS=8

# Groq — free key at https://console.groq.com  (OpenAI-compatible chat endpoint)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — key at https://aistudio.google.com (needs a project with generateContent quota)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
