# Gemini API configuration for AI mode
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Browser Settings
# Set to 'false' to watch the browser in headed mode (recommended for presentation/viva)
HEADLESS=false

# Agent Settings
# Maximum interaction steps for a single run
MAX_STEPS=10
